<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(PlatformTarget)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PlatformTarget)' != 'x86'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FtdcNet.CTP\FtdcNet.CTP.csproj">
      <GlobalPropertiesToRemove>PlatformTarget;RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(PlatformTarget)' != 'x86'">
    <None Include="..\..\..\Release\runtimes\win-x64\native\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(PlatformTarget)' == 'x86'">
    <None Include="..\..\..\Release\runtimes\win-x86\native\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
